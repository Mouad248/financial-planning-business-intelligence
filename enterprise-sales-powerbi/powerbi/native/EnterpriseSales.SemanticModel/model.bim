        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i45WMlSKjQUA\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Placeholder = _t]),\n    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Placeholder\", Int64.Type}})\nin\n    #\"Changed Type\""
            }
          }
        ],
        "measures": [
          {
            "name": "Revenue",
            "expression": "SUM(FactSales[NetSalesAmount])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "77a41e18-b30d-4c3e-b96c-7cc3eea7216c",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Cost of Goods Sold",
            "expression": "SUM(FactSales[CostAmount])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "9d709819-8e16-4c6c-96ef-48bd2a5eca74",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Gross Profit",
            "expression": "SUM(FactSales[GrossProfitAmount])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "c64ee40d-3bc7-4c23-a417-7b4305bf1895",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Gross Margin %",
            "expression": "\nDIVIDE(\n    [Gross Profit],\n    [Revenue]\n)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "43bcfdcd-e3d9-41d2-81f5-f140ed649e6b",
            "dataType": "double"
          },
          {
            "name": "Units Sold",
            "expression": "\nSUM(FactSales[Quantity])",
            "formatString": "0",
            "lineageTag": "a069956e-e9e1-45b3-ac82-c8b36e41341e",
            "dataType": "int64"
          },
          {
            "name": "Invoice Count",
            "expression": "\nDISTINCTCOUNT(FactSales[InvoiceID])",
            "formatString": "0",
            "lineageTag": "44aa76fc-d71c-4b74-9295-905cba18ab9b",
            "dataType": "int64"
          },
          {
            "name": "Tax Amount",
            "expression": "\nSUM(FactSales[TaxAmount])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "04a33432-3047-4ed4-8e16-6b864c9b0776",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Invoice Value",
            "expression": "\nSUM(FactSales[InvoiceValueAmount])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "9e60c806-5298-4980-8f84-3e7ea420708e",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Average Revenue per Invoice",
            "expression": "\nDIVIDE(\n    [Revenue],\n    [Invoice Count]\n)",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "ce65e1fd-bb10-4acc-a7bb-bc1082115b1b",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Loss-Making Lines",
            "expression": "\nSUM(FactSales[IsLossMaking])",
            "formatString": "0",
            "lineageTag": "a2427b89-676a-4b48-9586-26234bdb05a2",
            "dataType": "int64"
          },
          {
            "name": "Loss-Making Revenue",
            "expression": "\nCALCULATE(\n    [Revenue],\n    FactSales[IsLossMaking] = 1\n)",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "b9c17984-c169-4f68-b02f-e56e7c997713",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Loss-Making Revenue %",
            "expression": "\nDIVIDE(\n    [Loss-Making Revenue],\n    [Revenue]\n)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "4a286f9f-0377-40f4-9977-73df9c5db8dc",
            "dataType": "double"
          },
          {
            "name": "Loss Amount",
            "expression": "\nCALCULATE(\n    [Gross Profit],\n    FactSales[IsLossMaking] = 1\n)",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "df0ed178-5728-4d6a-935e-6dba4d9c8503",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Revenue PY",
            "expression": "\nCALCULATE(\n    [Revenue],\n    SAMEPERIODLASTYEAR(DimDate[Date])\n)",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "b354a943-3b50-4d4f-b5b3-36b490c7d29f",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Revenue YoY Change",
            "expression": "\nVAR PreviousYearRevenue = [Revenue PY]\n\nRETURN\n    IF(\n        ISBLANK(PreviousYearRevenue),\n        BLANK(),\n        [Revenue] - PreviousYearRevenue\n    )",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "20f50c3e-1cf8-49a7-8537-5a823b74d90d",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Revenue YoY Growth %",
            "expression": "\nDIVIDE(\n    [Revenue YoY Change],\n    [Revenue PY]\n)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "d2f35bb0-aebc-4eae-8d2f-a5cdbfbcf0de",
            "dataType": "double"
          },
          {
            "name": "Revenue YTD",
            "expression": "\nTOTALYTD(\n    [Revenue],\n    DimDate[Date]\n)",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "99518ceb-89cd-41bb-805f-4af463a0c0ab",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Gross Profit YTD",
            "expression": "\nTOTALYTD(\n    [Gross Profit],\n    DimDate[Date]\n)",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "8925b078-2577-4cb8-b138-9cc7e7cfab79",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Latest Sales Date",
            "expression": "\nCALCULATE(\n    MAX(FactSales[InvoiceDate]),\n    REMOVEFILTERS(DimDate)\n)",
            "formatString": "General Date",
            "lineageTag": "371727e9-0c7b-417b-82d1-bcf6f2809afe",
            "dataType": "dateTime"
          },
          {
            "name": "Revenue PYTD",
            "expression": "\nVAR LastDateWithSales =\n    MAX(FactSales[InvoiceDate])\n\nVAR PreviousYearStart =\n    DATE(\n        YEAR(LastDateWithSales) - 1,\n        1,\n        1\n    )\n\nVAR PreviousYearEnd =\n    DATE(\n        YEAR(LastDateWithSales) - 1,\n        MONTH(LastDateWithSales),\n        DAY(LastDateWithSales)\n    )\n\nRETURN\n    CALCULATE(\n        [Revenue],\n        REMOVEFILTERS(DimDate),\n        DATESBETWEEN(\n            DimDate[Date],\n            PreviousYearStart,\n            PreviousYearEnd\n        )\n    )",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "b155debc-bf08-4ee7-8e3d-a05cd07726ca",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Revenue YTD YoY Change",
            "expression": "\n[Revenue YTD] - [Revenue PYTD]",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "3a4d1e46-ddd7-4daf-867e-1faa2318c300",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Revenue YTD YoY Growth %",
            "expression": "\nDIVIDE(\n    [Revenue YTD YoY Change],\n    [Revenue PYTD]\n)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "aed77e12-aa1b-41d7-9e2a-08e658fbd145",
            "dataType": "double"
          },
          {
            "name": "Rolling 12M Revenue",
            "expression": "\nVAR LastVisibleDate =\n    MAX(DimDate[Date])\n\nVAR LastDateWithSales =\n    [Latest Sales Date]\n\nRETURN\n    IF(\n        LastVisibleDate > LastDateWithSales,\n        BLANK(),\n        CALCULATE(\n            [Revenue],\n            DATESINPERIOD(\n                DimDate[Date],\n                LastVisibleDate,\n                -12,\n                MONTH\n            )\n        )\n    )",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "735f7868-8b0e-4e0d-8bc5-a80774722358",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Sales Lines",
            "expression": "\nCOUNTROWS(FactSales)",
            "formatString": "0",
            "lineageTag": "8e29d642-3dbc-432c-8941-fce7e81a8f0c",
            "dataType": "int64"
          },
          {
            "name": "Active Customers",
            "expression": "\nDISTINCTCOUNT(FactSales[CustomerID])",
            "formatString": "0",
            "lineageTag": "da998b82-f42f-45eb-850d-6101181a4f7e",
            "dataType": "int64"
          },
          {
            "name": "Products Sold",
            "expression": "\nDISTINCTCOUNT(FactSales[ProductID])",
            "formatString": "0",
            "lineageTag": "99a42738-b1e8-47ef-99ad-a5b182b2e5f6",
            "dataType": "int64"
          },
          {
            "name": "Average Selling Price",
            "expression": "\nDIVIDE(\n    [Revenue],\n    [Units Sold]\n)",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "3396a54f-1a4a-4097-adaa-858ad7476e9e",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Gross Profit per Unit",
            "expression": "\nDIVIDE(\n    [Gross Profit],\n    [Units Sold]\n)",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "33c96134-2293-4378-b535-306684a04136",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Loss-Making Line %",
            "expression": "\nDIVIDE(\n    [Loss-Making Lines],\n    [Sales Lines]\n)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "7cc1f248-9641-4fa3-8c61-fd52721fec94",
            "dataType": "double"
          },
          {
            "name": "Loss-Making Products",
            "expression": "\nCOUNTROWS(\n    FILTER(\n        VALUES(DimProduct[ProductID]),\n        [Gross Profit] < 0\n    )\n)",
            "formatString": "0",
            "lineageTag": "8b47de60-77ce-4b91-a843-8d60f917c4c6",
            "dataType": "int64"
          },
          {
            "name": "Product Revenue Rank",
            "expression": "\nIF(\n    ISINSCOPE(DimProduct[ProductName]),\n    RANKX(\n        ALLSELECTED(DimProduct[ProductName]),\n        [Revenue],\n        ,\n        DESC,\n        DENSE\n    )\n)",
            "formatString": "0",
            "lineageTag": "53d136c9-7736-49b8-8229-65ef56bed349",
            "dataType": "int64"
          },
          {
            "name": "Product Revenue Share %",
            "expression": "\nDIVIDE(\n    [Revenue],\n    CALCULATE(\n        [Revenue],\n        ALLSELECTED(DimProduct[ProductName])\n    )\n)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "0e550d55-82cb-4e17-bdc5-290ce23ae52a",
            "dataType": "double"
          },
          {
            "name": "Salesperson Revenue Rank",
            "expression": "\nIF(\n    ISINSCOPE(DimSalesperson[FullName]),\n    RANKX(\n        ALLSELECTED(DimSalesperson[FullName]),\n        [Revenue],\n        ,\n        DESC,\n        DENSE\n    )\n)",
            "formatString": "0",
            "lineageTag": "bf68c1af-2698-4eb1-bbe9-27654e9fe0dc",
            "dataType": "int64"
          },
          {
            "name": "Customer Revenue Rank",
            "expression": "\nIF(\n    ISINSCOPE(DimCustomer[CustomerName]),\n    RANKX(\n        ALLSELECTED(DimCustomer[CustomerName]),\n        [Revenue],\n        ,\n        DESC,\n        DENSE\n    )\n)",
            "formatString": "0",
            "lineageTag": "92d443f5-45fe-4a48-ba91-82b22b9bb013",
            "dataType": "int64"
          },
          {
            "name": "Customer Revenue Share %",
            "expression": "\nDIVIDE(\n    [Revenue],\n    CALCULATE(\n        [Revenue],\n        ALLSELECTED(DimCustomer[CustomerName])\n    )\n)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "abcd6f88-3d39-44ee-85d8-fa708df4a64e",
            "dataType": "double"
          },
          {
            "name": "Loss-Making Customers",
            "expression": "\nCOUNTROWS(\n    FILTER(\n        VALUES(DimCustomer[CustomerID]),\n        [Gross Profit] < 0\n    )\n)",
            "formatString": "0",
            "lineageTag": "f3638b13-a797-44ea-890c-07890953ee7d",
            "dataType": "int64"
          },
          {
            "name": "Customer Profitability Status",
            "expression": "\nVAR Margin = [Gross Margin %]\n\nRETURN\n    SWITCH(\n        TRUE(),\n        ISBLANK([Revenue]), BLANK(),\n        [Gross Profit] < 0, \"Loss-Making\",\n        Margin < 0.30, \"Low Margin\",\n        Margin < 0.50, \"Medium Margin\",\n        \"High Margin\"\n    )",
            "lineageTag": "f9bd76e8-4a39-41c7-8c3d-3956d7e891bb",
            "dataType": "string"
          },
          {
            "name": "Gross Margin Variance vs Overall",
            "expression": "\n[Gross Margin %]\n-\nCALCULATE(\n    [Gross Margin %],\n    ALLSELECTED(DimProduct[ProductName])\n)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "1f5cf076-a91a-4a01-bf3f-2bdd73d870f8",
            "dataType": "double"
          },
          {
            "name": "Top N Product Filter",
            "expression": "\nVAR SelectedTopN =\n    SELECTEDVALUE(\n        'Top N Products'[Top N Products],\n        10\n    )\n\nVAR ProductRank =\n    [Product Revenue Rank]\n\nRETURN\n    IF(\n        NOT ISBLANK(ProductRank)\n            && ProductRank <= SelectedTopN,\n        1,\n        0\n    )",
            "formatString": "0",
            "lineageTag": "8acb9921-3872-428f-8862-0d4b56b73517",
            "dataType": "int64"
          },
          {
            "name": "Top N Products Title",
            "expression": "\nVAR SelectedTopN =\n    SELECTEDVALUE(\n        'Top N Products'[Top N Products],\n        10\n    )\n\nRETURN\n    \"Top \"\n        & SelectedTopN\n        & \" Products by Revenue\"",
            "lineageTag": "883f8ec2-1c9c-45f3-a796-2a6cf107198a",
            "dataType": "string"
          },
          {
            "name": "Top N Salesperson Filter",
            "expression": "\nVAR SelectedTopN =\n    SELECTEDVALUE(\n        'Top N Salespeople'[Top N Salespeople],\n        5\n    )\n\nVAR SalespersonRank =\n    [Salesperson Revenue Rank]\n\nRETURN\n    IF(\n        NOT ISBLANK(SalespersonRank)\n            && SalespersonRank <= SelectedTopN,\n        1,\n        0\n    )",
            "formatString": "0",
            "lineageTag": "20f4679e-bb71-454a-9bb0-91a459d8a65c",
            "dataType": "int64"
          },
          {
            "name": "Selected Metric Name",
            "expression": "\nVAR SelectedMetrics =\n    SUMMARIZE(\n        'Metric Selector',\n        'Metric Selector'[Metric Selector],\n        'Metric Selector'[Metric Selector Fields]\n    )\n\nRETURN\n    IF(\n        COUNTROWS(SelectedMetrics) = 1,\n        MAXX(\n            SelectedMetrics,\n            'Metric Selector'[Metric Selector]\n        ),\n        \"Revenue\"\n    )",
            "lineageTag": "884ef032-cb0a-4632-9c55-d9968b7c9f4a",
            "dataType": "string"
          },
          {
            "name": "Product Metric Title",
            "expression": "\n\"Product Performance by \"\n    & [Selected Metric Name]",
            "lineageTag": "262d513a-44fa-4041-8c6e-825c6796d5a5",
            "dataType": "string"
          },
          {
            "name": "Budget",
            "expression": "\nSUM(FactBudget[BudgetAmount])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "1fe8c316-457c-44a5-8201-157f4bf62971",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Budget Variance",
            "expression": "\n[Revenue] - [Budget]",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "d0548976-0839-43d5-9171-bcbcf75d432f",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Budget Variance %",
            "expression": "\nDIVIDE(\n    [Budget Variance],\n    [Budget]\n)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "eb0237b6-2e05-44f3-967a-b5fd5af6ef7e",
            "dataType": "double"
          },
          {
            "name": "Budget Attainment %",
            "expression": "\nDIVIDE(\n    [Revenue],\n    [Budget]\n)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "249fc058-d9d0-4251-99c6-e03f440899ca",
            "dataType": "double"
          },
          {
            "name": "Current Year Budget to Cutoff",
            "expression": "\nVAR LastSalesDate =\n    [Latest Sales Date]\n\nVAR StartOfCurrentYear =\n    DATE(\n        YEAR(LastSalesDate),\n        1,\n        1\n    )\n\nRETURN\n    CALCULATE(\n        [Budget],\n        DATESBETWEEN(\n            DimDate[Date],\n            StartOfCurrentYear,\n            LastSalesDate\n        )\n    )",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "433e6157-06cb-4e21-9397-5fd64c353933",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Current Year Budget Variance",
            "expression": "\n[Revenue YTD]\n    - [Current Year Budget to Cutoff]",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "22f90d36-3424-47d7-9c50-58f406cbecf1",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Current Year Budget Variance %",
            "expression": "\nDIVIDE(\n    [Current Year Budget Variance],\n    [Current Year Budget to Cutoff]\n)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "227733c3-9dd0-4c16-bceb-aa0537793c5c",
            "dataType": "double"
          },
          {
            "name": "Budget Row Count",
            "expression": "COUNTROWS(FactBudget)",
            "formatString": "0",
            "lineageTag": "7a0ef3e5-e1da-4daa-b515-94f17203c94f",
            "dataType": "int64"
          },
          {
            "name": "Salesperson Target",
            "expression": "\nSUM(FactSalespersonTarget[TargetAmount])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "fc2d6a62-5de2-4f0c-b78f-cc6299b5a329",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Target Variance",
            "expression": "\n[Revenue] - [Salesperson Target]",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "16e0e3ba-9ec7-48cc-86fc-7ed9bf2e8524",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Target Variance %",
            "expression": "\nDIVIDE(\n    [Target Variance],\n    [Salesperson Target]\n)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "c10c3214-0305-4f77-a72c-ac85f2b951a3",
            "dataType": "double"
          },
          {
            "name": "Target Achievement %",
            "expression": "\nDIVIDE(\n    [Revenue],\n    [Salesperson Target]\n)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "01dfeef5-2565-4345-8896-0f16018dcdc8",
            "dataType": "double"
          },
          {
            "name": "Target Performance Status",
            "expression": "\nVAR Achievement =\n    [Target Achievement %]\n\nRETURN\n    SWITCH(\n        TRUE(),\n        ISBLANK(Achievement), BLANK(),\n        Achievement >= 1.05, \"Above Target\",\n        Achievement >= 1.00, \"On Target\",\n        Achievement >= 0.90, \"Slightly Below Target\",\n        \"Below Target\"\n    )",
            "lineageTag": "08edf7ab-5999-4819-a20e-d05973109a5c",
            "dataType": "string"
          },
          {
            "name": "Salespeople Below Target",
            "expression": "\nCOUNTROWS(\n    FILTER(\n        VALUES(DimSalesperson[SalespersonID]),\n        [Target Achievement %] < 1\n            && NOT ISBLANK([Target Achievement %])\n    )\n)",
            "formatString": "0",
            "lineageTag": "c9425356-f161-4b30-8bf1-815784484df9",
            "dataType": "int64"
          },
          {
            "name": "Comparable Revenue",
            "expression": "\nVAR FirstBudgetDate =\n    CALCULATE(\n        MIN(FactBudget[BudgetMonth]),\n        REMOVEFILTERS(DimDate)\n    )\nVAR LastSalesDate =\n    [Latest Sales Date]\nRETURN\n    CALCULATE(\n        [Revenue],\n        KEEPFILTERS(\n            DATESBETWEEN(\n                DimDate[Date],\n                FirstBudgetDate,\n                LastSalesDate\n            )\n        )\n    )",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "9588f1ba-1d1c-4cc0-837c-89a6a8b74bb1",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Comparable Budget",
            "expression": "\nVAR LastSalesDate =\n    [Latest Sales Date]\nRETURN\n    CALCULATE(\n        [Budget],\n        KEEPFILTERS(\n            DimDate[Date] <= LastSalesDate\n        )\n    )",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "b43117af-579e-4a4b-885c-4e00471f5a0b",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Comparable Budget Attainment %",
            "expression": "\nDIVIDE(\n    [Comparable Revenue],\n    [Comparable Budget]\n)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "0c7e6101-1759-4086-ada8-2d680aca4d21",
            "dataType": "double"
          },
          {
            "name": "Target Row Count",
            "expression": "\nCOUNTROWS(FactSalespersonTarget)",
            "formatString": "0",
            "lineageTag": "53e0066b-3e2e-403f-96be-583d6dda6059",
            "dataType": "int64"
          },
          {
            "name": "Comparable Salesperson Target",
            "expression": "\nVAR SelectedYear =\n    SELECTEDVALUE(DimDate[Year])\n\nVAR LastSalesDate =\n    [Latest Sales Date]\n\nVAR MonthsToCompare =\n    SWITCH(\n        TRUE(),\n        ISBLANK(SelectedYear), BLANK(),\n        SelectedYear < YEAR(LastSalesDate), 12,\n        SelectedYear = YEAR(LastSalesDate), MONTH(LastSalesDate),\n        0\n    )\n\nVAR AnnualTarget =\n    [Salesperson Target]\n\nRETURN\n    IF(\n        ISBLANK(AnnualTarget) || ISBLANK(MonthsToCompare),\n        BLANK(),\n        AnnualTarget * DIVIDE(MonthsToCompare, 12)\n    )",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "f232c271-ef3f-48b7-87ff-701387348daf",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Comparable Target Variance",
            "expression": "\n[Revenue] - [Comparable Salesperson Target]",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "ec740f85-e151-428c-a9de-00e81fd1371d",
            "dataType": "decimal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Comparable Target Achievement %",
            "expression": "\nDIVIDE(\n    [Revenue],\n    [Comparable Salesperson Target]\n)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "dd94b45b-2f60-49e1-86e3-ccddd701c8f3",
            "dataType": "double"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ]
      },
